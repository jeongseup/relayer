[Unit]
Description=Across Protocol Relayer
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/relayer
EnvironmentFile=/home/admin/relayer/.env
ExecStart=/home/admin/.local/node/bin/node ./dist/index.js --relayer --wallet privateKey
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=across-relayer

[Install]
WantedBy=multi-user.target
